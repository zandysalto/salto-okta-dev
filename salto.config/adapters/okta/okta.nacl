okta {
  fetch = {
    include = [
      {
        type = ".*"
      },
      {
        type = "User"
      },
    ]
    exclude = [
      {
        type = "Application"
        criteria = {
          name = "Cloud_13*"
        }
      },
      {
        type = "ProfileMapping"
      },
    ]
    isClassicOrg = true
  }
}
